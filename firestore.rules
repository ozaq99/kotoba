rules_version = '2';

// Kotoba Cabinet — Firestore security rules.
//
// This app has no backend. The browser talks to Firestore directly, so these
// rules ARE the entire server-side authorisation layer.
//
// Data model:
//   userData/{uid}     -> private. { lists, activeId, customWords, history, shareScores, nickname }
//   leaderboard/{uid}  -> public summary, written by the app when the user opts in.
//                         { displayName, totalQuizzes, avgPct, bestPct, streak, updatedAt }
//
// Deploy: Firebase Console -> Firestore Database -> Rules tab -> paste -> Publish
//     or: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Private data. Only the owner can read/write.
    match /userData/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public score summaries.
    // Any signed-in user can read the list. You can only write/delete your own
    // card, and only with exactly these 6 fields in valid ranges.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;

      allow delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'totalQuizzes', 'avgPct', 'bestPct', 'streak', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.totalQuizzes is int
        && request.resource.data.totalQuizzes >= 0
        && request.resource.data.avgPct is number
        && request.resource.data.avgPct >= 0
        && request.resource.data.avgPct <= 100
        && request.resource.data.bestPct is number
        && request.resource.data.bestPct >= 0
        && request.resource.data.bestPct <= 100
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.updatedAt is string;
    }

    // Everything else: blocked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
