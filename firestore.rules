rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Private data. Only the owner can read/write. (unchanged) ──
    match /userData/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── NEW: public score summaries ──
    // Anyone logged in can READ the whole list.
    // You can only WRITE/DELETE your own card, and only with these exact 6 fields.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;

      allow delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'totalQuizzes', 'avgPct', 'bestPct', 'streak', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.totalQuizzes is int
        && request.resource.data.totalQuizzes >= 0
        && request.resource.data.avgPct is number
        && request.resource.data.avgPct >= 0
        && request.resource.data.avgPct <= 100
        && request.resource.data.bestPct is number
        && request.resource.data.bestPct >= 0
        && request.resource.data.bestPct <= 100
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.updatedAt is string;
    }

    // ── Everything else: blocked. (unchanged) ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}